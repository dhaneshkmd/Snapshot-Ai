{
  "name": "SnapAction AI",
  "short_name": "SnapAction",
  "description": "Screenshot Anything. Turn It Into Action.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192' fill='%233b82f6'%3E%3Crect width='192' height='192' rx='40' fill='%230f172a'/%3E%3Cpath d='M96 40 L136 80 L112 80 L112 136 L80 136 L80 80 L56 80 Z' fill='%233b82f6'/%3E%3Ccircle cx='96' cy='152' r='8' fill='%2360a5fa'/%3E%3C/svg%3E",
      "sizes": "192x192",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/?share-target=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
